# Modo de execução: "webhook" (recomendado) ou "polling"
MODE=webhook

# ---------- Google Drive ----------
# JSON da Service Account. Aceita o conteúdo em uma linha, o conteúdo em base64
# ou o caminho para o arquivo .json (fora do repositório).
GOOGLE_SERVICE_ACCOUNT_JSON=/caminho/seguro/service-account.json
# ID da pasta "Fotos" (o trecho final da URL da pasta no Drive)
GOOGLE_DRIVE_FOTOS_FOLDER_ID=

# ---------- API da plataforma ----------
PLATFORM_API_KEY=
# URL base da API. Obrigatória no modo polling e para salvar o ID da pasta no cliente.
PLATFORM_API_BASE_URL=https://api.suaplataforma.com/v1
# Cabeçalho de autenticação. Com o esquema vazio, envia apenas a chave.
PLATFORM_API_AUTH_HEADER=Authorization
PLATFORM_API_AUTH_SCHEME=Bearer
# Rotas de listagem e de atualização de clientes ({id} é substituído pelo ID)
PLATFORM_CLIENTS_PATH=/clientes
PLATFORM_CLIENT_PATH=/clientes/{id}
# Se a listagem vier dentro de um objeto, por exemplo {"data": [...]}, informe a chave
PLATFORM_CLIENTS_LIST_KEY=
# Nomes dos campos no cadastro do cliente
PLATFORM_CLIENT_ID_FIELD=id
PLATFORM_CLIENT_NAME_FIELD=nome
# Campo onde gravar o ID da pasta criada. Deixe vazio se a API não permitir.
PLATFORM_DRIVE_FOLDER_FIELD=
PLATFORM_UPDATE_METHOD=PATCH

# ---------- Webhook ----------
PORT=3000
WEBHOOK_PATH=/webhooks/cliente-criado
# Segredo compartilhado com a plataforma (recomendado)
WEBHOOK_SECRET=
WEBHOOK_SECRET_HEADER=x-webhook-secret

# ---------- Polling ----------
# 300000 ms = 5 minutos
POLL_INTERVAL_MS=300000
STATE_FILE=data/processed-clients.json

# ---------- Retry ----------
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=1000
